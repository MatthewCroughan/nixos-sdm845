From bdb6c4f68c7a4b795d52422bf88e10f5ee13ca27 Mon Sep 17 00:00:00 2001
From: matthewcroughan <matt@croughan.sh>
Date: Sat, 7 Mar 2026 19:10:04 +0000
Subject: [PATCH] Revert "stalled! arm64: dts: qcom: sdm845-oneplus: Enable
 NFC"

This reverts commit b50616fd43a7cc41ca1376bed94e41edada30554.
---
 .../boot/dts/qcom/sdm845-oneplus-common.dtsi  | 26 +------------------
 1 file changed, 1 insertion(+), 25 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sdm845-oneplus-common.dtsi b/arch/arm64/boot/dts/qcom/sdm845-oneplus-common.dtsi
index 0a895fe29166..e21a2beca0cf 100644
--- a/arch/arm64/boot/dts/qcom/sdm845-oneplus-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/sdm845-oneplus-common.dtsi
@@ -740,19 +740,7 @@ &i2c3 {
 
 	status = "okay";
 
-	nfc@28 {
-		compatible = "nxp,nxp-nci-i2c";
-		reg = <0x28>;
-
-		interrupt-parent = <&tlmm>;
-		interrupts = <63 IRQ_TYPE_LEVEL_HIGH>;
-
-		enable-gpios = <&tlmm 12 GPIO_ACTIVE_HIGH>;
-		firmware-gpios = <&tlmm 62 GPIO_ACTIVE_HIGH>;
-
-		pinctrl-0 = <&nfc_default>;
-		pinctrl-names = "default";
-	};
+	/* nxp,nxp-nci-i2c @28 */
 };
 
 &i2c10 {
@@ -969,11 +957,6 @@ &qupv3_id_0 {
 	status = "okay";
 };
 
-&qup_i2c3_default {
-	drive-strength = <2>;
-	bias-disable;
-};
-
 &qup_i2c10_default {
 	drive-strength = <2>;
 	bias-disable;
@@ -1480,13 +1463,6 @@ speaker_default: speaker-default-state {
 		bias-pull-up;
 		output-high;
 	};
-
-	nfc_default: nfc-default-state {
-		pins = "gpio12", "gpio62", "gpio63";
-		function = "gpio";
-		drive-strength = <6>;
-		bias-pull-up;
-	};
 };
 
 &venus {
-- 
2.53.0


